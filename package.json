{
  "name": "svws-conference",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-offline.mjs",
    "build:vite": "vite build && node scripts/copy-impressum.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest run",
    "electron:dev": "npm run build && GSETTINGS_SCHEMA_DIR=$HOME/.local/share/electron-schemas electron . --no-sandbox --ozone-platform=x11",
    "electron:build": "npm run build && electron-builder",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "de.skinwalker.svws-conference",
    "productName": "SVWS Konferenzübersicht",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "fflate": "^0.8.2",
    "jspdf": "^4.2.1",
    "marked": "^18.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "esbuild": "^0.25.3",
    "electron": "^42.3.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
